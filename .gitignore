# Secrets and local settings
.env
.env.*
!.env.example
secrets/
secret/
.envrc
.claude/settings.local.json
.claude/worktrees/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node
node_modules/
frontend/dist/
playwright-report/
test-results/
blob-report/

# Never real health data or app packages in the repository
*.apk
*.xapk
probe-output*
# The owner's local real-account session (docs/dev/local-real-account.md); the same rules are
# enforced by scripts/local-real-guard.sh (pre-commit, pre-push, and the backend guard test)
local-real/
*.dump
*.pgdump
*.pg_dump
*.backup
*.bak
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
*.sql.zip
*.sql.7z
*dump*.sql
# Plain .sql is source only under docker/postgres/<area>/; elsewhere it is taken for a dump
*.sql
!/docker/postgres/*/*.sql
/docker/postgres/*/*dump*.sql
# Archives (the app's data export is a .zip), CSV (but synthetic_ fixtures) and HAR exports
*.tar
*.tgz
*.tbz2
*.txz
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.zip
*.har
*.csv
!synthetic_*.csv

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
frontend/dist-public/
