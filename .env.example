# Copy to .env (scripts/worktree.sh init does it). Placeholders only: no secrets here.
# Passwords and keys live in secrets/ (also created by scripts/worktree.sh init), never in this
# file; the stack mounts them as Docker secret files.
COMPOSE_PROJECT_NAME=ownvitals
WEB_PORT=8000
DB_PORT=55432
# Used by the mail service once the stack has one.
MAILPIT_PORT=8025
# The id of the current connection KEK (secrets/connection_kek). On rotation: a new id here and
# the old file kept as secrets/connection_kek_<old id>.
CONNECTION_KEK_ID=kek-1
